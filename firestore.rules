rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      allow create: if !exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
        request.resource.data.keys().hasAll(['name','whatsapp','studentKey','answers','score','percentage','submittedAt']) &&
        request.resource.data.studentKey == submissionId &&
        request.resource.data.answers.size() == 10 &&
        request.resource.data.score >= 0 && request.resource.data.score <= 10 &&
        request.resource.data.percentage == request.resource.data.score * 10;
      allow read, update, delete: if false;
    }
  }
}